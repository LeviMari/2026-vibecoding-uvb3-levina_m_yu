# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI-совместимый LLM API (например, LLM Gateway курса)
LLM_BASE_URL=https://llmgateway.nikolaitimofeev.ru/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-5.4-mini

# Часовой пояс для дедлайнов, уведомлений и календаря
TIMEZONE=Asia/Tbilisi

# Путь к базе SQLite. По умолчанию bot.db рядом с кодом.
# На хостинге укажите путь на постоянном диске, например /data/bot.db
DB_PATH=bot.db

# Ваш Telegram user_id — только он видит /admin (узнать можно у @userinfobot)
ADMIN_ID=

# Необязательно. Модель распознавания речи на том же шлюзе (голосовые и записи встреч).
# Если пусто — бот пробует openai/gpt-4o-mini-transcribe, затем openai/whisper-1.
STT_MODEL=

# Необязательно. Ключ сервисного аккаунта Google для /sheets (онлайн-таблица):
# сам JSON одной строкой или base64 от файла ключа (base64 -i key.json | pbcopy).
GOOGLE_SERVICE_ACCOUNT_JSON=
